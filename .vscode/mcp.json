{
  // Code Map MCP server for Copilot agent mode. It reads the output of the config in
  // CODE_MAP_CONFIG (.env), else the demo extract (./codemap.sh extract).
  // On Windows use ${workspaceFolder}\\.venv\\Scripts\\python.exe. See README "Bật MCP cho AI agent".
  "servers": {
    "codemap": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "codemap", "mcp"]
    }
  }
}
