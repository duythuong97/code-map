{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Test .NET/Python SQL parity",
			"type": "process",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"unittest",
				"-v",
				"tests.test_dotnet_sql_parity"
			],
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "strict-review-tests",
			"type": "process",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"unittest",
				"discover",
				"-s",
				"tests",
				"-p",
				"test_*.py",
				"-v"
			],
			"problemMatcher": [],
			"group": "test"
		}
	]
}
