<Project Sdk="Microsoft.NET.Sdk">
  <!-- Long-lived Oracle SQL parser for the Python extractors (JSON lines on stdin/stdout). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <CodeTreeTargetFramework Condition="'$(CodeTreeTargetFramework)' == ''">net9.0</CodeTreeTargetFramework>
    <TargetFramework>$(CodeTreeTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <!-- Workstation GC: server GC reserves a heap per core. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../_sql/CodeTree.Sql.csproj" />
  </ItemGroup>
</Project>
