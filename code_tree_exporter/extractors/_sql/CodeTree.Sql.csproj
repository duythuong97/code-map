<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Oracle SQL / PL-SQL analysis on the ANTLR C# runtime. Used in-process by the
    Roslyn extractors and, through CodeTreeSqlService, by the Python extractors.
    Grammar/PlSql*.cs are generated; see Grammar/REGENERATE.md.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CodeTree.Sql</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS0108;CS3021;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>
</Project>
