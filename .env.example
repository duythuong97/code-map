# Copy to .env on each machine. Every setting is optional: without .env
# codemap.cmd / codemap.sh, the web app and the MCP server use the demo (examples/demo-config.json).

# The extractor config to extract and serve. Its root (source), output (extract
# result) and optional "web" section are the only place those paths are written.
# A relative path resolves against this repository. On Windows forward slashes
# avoid escaping: D:/code-map-prod/code-map.json
CODE_MAP_CONFIG=

# Required to save notes from the web UI and to use the MCP propose_* tools over HTTP.
# Empty: those writes are refused.
CODE_MAP_KNOWLEDGE_TOKEN=

# Optional when the executable is on PATH.
# macOS/Linux example: /usr/local/share/dotnet/dotnet
# Windows example: C:/Program Files/dotnet/dotnet.exe
CODE_TREE_DOTNET=
# macOS/Linux example: /usr/local/bin/node
# Windows example: C:/Program Files/nodejs/node.exe
CODE_TREE_NODE=

# Optional: backend log level (default INFO) and pm2 process name (default code-map).
# CODE_MAP_BACKEND_LOG_LEVEL=INFO
# CODE_MAP_PM2_NAME=code-map
