# Copy to .env on each machine and adjust the paths.

# Backend (absolute paths required).
CODE_MAP_PROJECT_ROOT=/absolute/path/to/code-map
# Folder containing the scanned repositories; also used to show source snippets.
CODE_MAP_SOURCE_ROOT=/absolute/path/to/code-map/examples/sample-source
# Extract output folder the web app reads (codemap-web.sqlite, graph.sqlite).
CODE_MAP_GRAPH_OUTPUT=/absolute/path/to/code-map/output/demo
CODE_MAP_BACKEND_LOG_LEVEL=INFO
CODE_MAP_GRAPH_API_PREFIX=/api/graph
CODE_MAP_MAX_CONTENT_LENGTH=16777216
CODE_MAP_KNOWLEDGE_TOKEN=change-me
CODE_MAP_PM2_NAME=code-map

# Extractor (examples/demo-config.json). Relative paths resolve against the config file.
CODE_TREE_OUTPUT=../output/demo
CODE_MAP_INPUT_DATA=./input-data
CODE_TREE_CATALOG=./catalog

# Optional when the executable is on PATH.
# macOS/Linux example: /usr/local/share/dotnet/dotnet
# Windows example: C:\Program Files\dotnet\dotnet.exe
CODE_TREE_DOTNET=
# macOS/Linux example: /usr/local/bin/node
# Windows example: C:\Program Files\nodejs\node.exe
CODE_TREE_NODE=
