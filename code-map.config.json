{
  "db": "code_map.db",
  "api": {
    "url_prefix": "/code-map",
    "host": "127.0.0.1",
    "port": 8000,
    "pm2_name": "code-map",
    "python": "",
    "python_no_site": true,
    "venv_python": "python3.13"
  },
  "imports": {
    "csv": [
      {
        "id": "sample-table-definitions",
        "path": "samples/table_definitions",
        "kind": "table_definitions",
        "db_name": "OracleHRDB",
        "schema": "HR",
        "priority": 0
      }
    ]
  },
  "extractors": {
    "state": {
      "log_path": "logs/extraction.log",
      "log_max_bytes": 10485760,
      "log_backups": 5
    },
    "features": {
      "antlr_plsql_calls": true
    },
    "sources": [
      {
        "id": "sample-plsql",
        "path": "samples",
        "repo": "samples",
        "db_name": "OracleHRDB",
        "schema": "HR",
        "priority": 0,
        "exclude": [
          "**/bin/**",
          "**/obj/**",
          "**/.git/**",
          "dummy_graph_10_levels.sql"
        ],
        "rules": [
          {
            "patterns": [
              "**/*.sql",
              "**/*.pks",
              "**/*.pkb",
              "**/*.pck",
              "**/*.pls",
              "**/*.plb",
              "**/*.fnc",
              "**/*.prc",
              "**/*.trg"
            ],
            "extractor": "oracle_plsql",
            "owner": "callable_or_file"
          },
          {
            "patterns": ["**/*.xml"],
            "extractor": "xml_sql",
            "owner": "file"
          },
          {
            "patterns": ["**/*.cs"],
            "extractor": "csharp_sql",
            "owner": "repository_or_project"
          }
        ]
      }
    ]
  }
}
